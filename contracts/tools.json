          }
        },
        "required": [
          "connection_id"
        ],
        "title": "financial_broker_accountArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "financial_broker_positions",
      "description": "Read positions from a configured account in this user's service process.",
      "inputSchema": {
        "properties": {
          "connection_id": {
            "title": "Connection Id",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "connection_id"
        ],
        "title": "financial_broker_positionsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
