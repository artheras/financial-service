      "name": "financial_cn_macro",
      "description": "China macro snapshot via akshare: CPI, PPI, manufacturing and services PMI, GDP growth, LPR and money supply, when the host enabled networking and installed the [cn] extra.",
      "inputSchema": {
        "properties": {
          "indicator": {
            "default": "all",
            "title": "Indicator",
            "type": "string"
          },
          "periods": {
            "default": 12,
            "title": "Periods",
            "type": "integer"
          }
        },
        "title": "financial_cn_macroArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "financial_central_bank_rates",
      "description": "Policy rates for the Fed, ECB, UK, Japan and the PBOC LPR, each with its date and a stale flag, when the host enabled networking.",
      "inputSchema": {
        "properties": {},
