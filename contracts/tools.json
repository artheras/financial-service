{
  "version": 1,
  "transport": "stdio",
  "tools": [
    {
      "name": "financial_service_info",
      "description": "Describe this service version and its host-selected network capability.",
      "inputSchema": {
        "properties": {},
        "title": "financial_service_infoArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "financial_analyze_statements",
      "description": "Compute margins and Dupont metrics from supplied statements, or host-enabled Yahoo/SEC data. Missing values stay unknown.",
      "inputSchema": {
        "properties": {
          "company_name": {
            "default": "",
            "title": "Company Name",
            "type": "string"
          },
          "financials": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Financials"
          }
        },
        "title": "financial_analyze_statementsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "financial_parse_sec_facts",
      "description": "Parse supplied SEC companyfacts, keeping one aligned annual filing and its provenance. Does not access the network.",
      "inputSchema": {
        "properties": {
          "facts": {
            "additionalProperties": true,
            "title": "Facts",
            "type": "object"
          }
        },
        "required": [
          "facts"
        ],
        "title": "financial_parse_sec_factsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "financial_risk_metrics",
      "description": "Calculate drawdown, total return and sample Sharpe on ordered equity values with an explicit annual-frequency assumption.",
      "inputSchema": {
        "properties": {
          "equity": {
            "items": {
              "type": "number"
            },
            "title": "Equity",
            "type": "array"
          },
          "periods_per_year": {
            "default": 252,
            "title": "Periods Per Year",
            "type": "number"
          }
        },
        "required": [
          "equity"
        ],
        "title": "financial_risk_metricsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "financial_backtest",
      "description": "Simulate supplied daily OHLC bars with buy_hold or sma_cross; orders fill at the next open. Does not place trades.",
      "inputSchema": {
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "strategy": {
            "default": "buy_hold",
            "title": "Strategy",
            "type": "string"
          },
          "starting_cash": {
            "default": 100000,
            "title": "Starting Cash",
            "type": "number"
          },
          "commission": {
            "default": 0.0005,
            "title": "Commission",
            "type": "number"
          },
          "slippage": {
            "default": 0.0005,
            "title": "Slippage",
            "type": "number"
          },
          "fast": {
            "default": 10,
            "title": "Fast",
            "type": "integer"
          },
          "slow": {
            "default": 30,
            "title": "Slow",
            "type": "integer"
          }
        },
        "required": [
          "data"
        ],
        "title": "financial_backtestArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "financial_technical_factors",
      "description": "Momentum, moving averages and gaps, volatility, RSI(14), MACD, Bollinger position, volume ratio and beta for caller-supplied daily closes (oldest first; e.g. from financial_market_history). No network.",
      "inputSchema": {
        "properties": {
          "closes": {
            "items": {
              "type": "number"
            },
            "title": "Closes",
            "type": "array"
          },
          "volumes": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Volumes"
          },
          "benchmark_closes": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Benchmark Closes"
          }
        },
        "required": [
          "closes"
        ],
        "title": "financial_technical_factorsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "financial_optimize_weights",
      "description": "Portfolio weights (max_sharpe, min_var or equal_weight) from caller-supplied, date-aligned closes for 2..20 symbols, with expected return, volatility and Sharpe. A historical estimate, not advice. No network.",
      "inputSchema": {
        "properties": {
          "prices": {
            "additionalProperties": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Prices",
            "type": "object"
          },
          "method": {
            "default": "max_sharpe",
            "title": "Method",
            "type": "string"
          },
          "risk_free_rate": {
            "default": 0.04,
            "title": "Risk Free Rate",
            "type": "number"
          },
          "periods_per_year": {
            "default": 252,
            "title": "Periods Per Year",
            "type": "integer"
          }
        },
        "required": [
          "prices"
        ],
        "title": "financial_optimize_weightsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "financial_quality_scores",
      "description": "Piotroski F-score and Altman Z''-score from caller-supplied statement fields for the current and prior fiscal year. Missing inputs leave signals null; no verdict is given unless all are evaluated. No network.",
      "inputSchema": {
        "properties": {
          "current": {
            "additionalProperties": true,
            "title": "Current",
            "type": "object"
          },
          "prior": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Prior"
          }
        },
        "required": [
          "current"
        ],
        "title": "financial_quality_scoresArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "financial_market_history",
      "description": "Fetch unadjusted daily Yahoo history only when the host enabled networking. Reports source and dates; not a live quote.",
      "inputSchema": {
        "properties": {
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "days": {
            "default": 90,
            "title": "Days",
            "type": "integer"
          }
        },
        "required": [
          "symbol"
        ],
        "title": "financial_market_historyArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "financial_quote",
      "description": "Latest quote from the first configured source that answers (yfinance, Finnhub, Alpha Vantage, Tushare, AkShare), when the host enabled networking. Names its source; may be delayed.",
      "inputSchema": {
        "properties": {
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol"
        ],
        "title": "financial_quoteArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "financial_fundamentals",
      "description": "Valuation and growth metrics (PE, PB, ROE, growth, dividend yield, market value) from the first configured source that has them, when the host enabled networking.",
      "inputSchema": {
        "properties": {
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol"
        ],
        "title": "financial_fundamentalsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "financial_macro_series",
      "description": "Macroeconomic time series from FRED (US10Y, CPI, UNRATE, FEDFUNDS, M2 or any series id) or the World Bank (GDP, CPI and indicator codes, by country), when the host enabled networking.",
      "inputSchema": {
        "properties": {
          "series": {
            "title": "Series",
            "type": "string"
          },
          "source": {
            "default": "fred",
            "title": "Source",
            "type": "string"
          },
          "country": {
            "default": "US",
            "title": "Country",
            "type": "string"
          },
          "years": {
            "default": 10,
            "title": "Years",
            "type": "integer"
          }
        },
        "required": [
          "series"
        ],
        "title": "financial_macro_seriesArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "financial_us_macro",
      "description": "US macro snapshot from FRED: GDP growth, CPI and core CPI year on year, fed funds, unemployment, 2y and 10y yields with the curve shape, M2, PPI and more; latest, previous and recent observations, when the host enabled networking.",
      "inputSchema": {
        "properties": {
          "indicator": {
            "default": "all",
            "title": "Indicator",
            "type": "string"
          },
          "periods": {
            "default": 12,
            "title": "Periods",
            "type": "integer"
          }
        },
        "title": "financial_us_macroArguments",
        "type": "object"
